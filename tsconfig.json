{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"incremental": true,
		// Keep the build cache out of dist/ - "files" in package.json is an
		// allowlist that overrides .npmignore, so anything left in dist/ ships.
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/",
	},
	"include": [
		"index.ts",
		"credentials/**/*",
		"nodes/**/*",
		"nodes/**/*.json",
		"package.json",
	],
}
