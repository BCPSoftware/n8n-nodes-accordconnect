{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// Incremental builds are deliberately off. The build cache cannot live
		// in dist/ ("files" is an allowlist that overrides .npmignore, so it
		// would ship), but keeping it outside dist/ means `rm -rf dist` leaves
		// a cache tsc still believes, and it then emits almost nothing - a
		// 2-file package that looks like a successful build. A full compile
		// takes a couple of seconds; correctness is worth more.
		"incremental": false,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/",
	},
	"include": [
		"index.ts",
		"credentials/**/*",
		"nodes/**/*",
		"nodes/**/*.json",
		"package.json",
	],
}
