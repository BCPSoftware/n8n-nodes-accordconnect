{
  "name": "n8n-nodes-accordconnect",
  "version": "1.0.0",
  "description": "n8n community node for Accord Connect ERP system integration with API operations and webhook support",
  "keywords": [
    "n8n-community-node-package",
    "accord-connect",
    "erp",
    "api",
    "webhook",
    "integration"
  ],
  "license": "MIT",
  "homepage": "https://github.com/BCPSoftware/n8n-nodes-accordconnect#readme",
  "author": {
    "name": "BCP Software",
    "email": "david.shield@bcpsoftware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BCPSoftware/n8n-nodes-accordconnect.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "generate": "node scripts/openapi-generator.js http://accordconnectapireference.bcpsoftware.com/accordconnectreference.yaml",
    "generate:from-openapi": "node scripts/openapi-generator.js",
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "build:all": "pnpm generate && pnpm build",
    "dev": "tsc --watch",
    "dev:start": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:logs": "docker-compose -f docker-compose.dev.yml logs -f n8n",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "prepublishOnly": "pnpm build && pnpm exec eslint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AccordConnectApi.credentials.js",
      "dist/credentials/AccordSecretApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AccordConnect/AccordConnect.node.js",
      "dist/nodes/AccordWebhookTrigger/AccordWebhookTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^30.2.0",
    "n8n-core": "^1.14.1",
    "n8n-workflow": "^1.48.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.3.2",
    "swagger-parser": "^10.0.3",
    "title-case": "^3.0.3",
    "ts-jest": "^29.4.4",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/BCPSoftware/n8n-nodes-accordconnect/issues"
  }
}
